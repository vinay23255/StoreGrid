{
  "name": "storegrid-backend",
  "version": "1.0.0",
  "description": "StoreGrid - Voice-of-Store Engine Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:backend": "node --watch src/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:all": "node scripts/start-dev.js",
    "build:frontend": "npm run build --prefix frontend",
    "test": "node --test tests/*.test.js",
    "seed": "node scripts/seed.js",
    "db:migrate": "node scripts/migrate.js"
  },
  "keywords": [
    "storegrid",
    "retail",
    "voice-of-store",
    "hackathon",
    "express",
    "postgresql",
    "prisma"
  ],
  "author": "Vinay (Team Lead) - StoreGrid Team",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "pg": "^8.13.3",
    "xlsx": "^0.18.5"
  }
}
